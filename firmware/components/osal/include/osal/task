#pragma once

#include <cstdint>
#include <cstddef>

namespace osal {

class task {
public:
    using entry_t = void(*)(void* param);

    struct config {
        const char* name       = nullptr;
        int         priority   = 10;
        size_t      stack_size = 1024;
        void*       param      = nullptr;
    };

    task() = default;
    task(entry_t entry, const config& cfg);
    ~task();

    task(const task&) = delete;
    task& operator=(const task&) = delete;

    bool create(entry_t entry, const config& cfg);
    bool start();
    bool terminate();
    bool suspend();
    bool resume();

    bool joinable() const;
    void join();

    static void sleep_for(uint32_t ms);
    static void yield();

private:
    alignas(8) unsigned char storage_[128]{};
    bool created_ = false;
    bool started_ = false;
};

} // namespace osal

// arch dispatch
#if defined(OSAL_ARCH_linux)
#include "arch/linux/task_impl.hpp"
#elif defined(OSAL_ARCH_microbit)
#include "arch/microbit/task_impl.hpp"
#else
#error "OSAL_ARCH not defined"
#endif
