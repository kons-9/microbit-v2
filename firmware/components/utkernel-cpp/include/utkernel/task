#pragma once

/**
 * @file task
 * @brief OSAL Task — タスク管理
 */

#include <cstdint>
#include <cstddef>

namespace utkernel {

class task {
public:
    using entry_t = void (*)(void *param);

    struct config {
        const char *name       = nullptr;
        int32_t     priority   = 10;
        size_t      stack_size = 1024;
        void       *param      = nullptr;
    };

    task() = default;
    task(entry_t entry, const config &cfg);
    ~task();

    task(const task &) = delete;
    task &operator=(const task &) = delete;

    bool create(entry_t entry, const config &cfg);
    bool start();
    bool terminate();
    bool suspend();
    bool resume();

    bool joinable() const;
    void join();

    static void sleep_for(uint32_t ms);
    static void yield();
    static void sleep_forever();

private:
    alignas(8) unsigned char m_storage[128]{};
    bool m_created = false;
    bool m_started = false;
};

}  // namespace utkernel

#if defined(UTKERNEL_ARCH_linux)
#include "arch/linux/task_impl.hpp"
#elif defined(UTKERNEL_ARCH_microbit)
#include "arch/microbit/task_impl.hpp"
#else
#error "UTKERNEL_ARCH not defined"
#endif
