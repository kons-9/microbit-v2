#pragma once

/**
 * @file semaphore
 * @brief OSAL Semaphore — カウンティングセマフォ
 */

#include <cstdint>
#include <climits>

namespace utkernel {

template <int LeastMaxValue = INT_MAX>
class counting_semaphore {
public:
    explicit counting_semaphore(int32_t initial);
    ~counting_semaphore();

    counting_semaphore(const counting_semaphore &) = delete;
    counting_semaphore &operator=(const counting_semaphore &) = delete;

    void acquire();
    bool try_acquire();
    bool try_acquire_for(uint32_t timeout_ms);
    void release(int32_t update = 1);

private:
    alignas(8) unsigned char m_storage[128];
};

using binary_semaphore = counting_semaphore<1>;

}  // namespace utkernel

#if defined(UTKERNEL_ARCH_linux)
#include "arch/linux/semaphore_impl.hpp"
#elif defined(UTKERNEL_ARCH_microbit)
#include "arch/microbit/semaphore_impl.hpp"
#else
#error "UTKERNEL_ARCH not defined"
#endif
