#pragma once

/**
 * @file msgbuf
 * @brief OSAL MessageBuffer — メッセージバッファ
 */

#include <cstdint>
#include <cstddef>

namespace utkernel {

class message_buffer {
public:
    message_buffer(size_t buf_size, size_t max_msg_size);
    ~message_buffer();

    message_buffer(const message_buffer &) = delete;
    message_buffer &operator=(const message_buffer &) = delete;

    bool send(const void *data, size_t size, uint32_t timeout_ms = UINT32_MAX);
    size_t receive(void *data, size_t max_size, uint32_t timeout_ms = UINT32_MAX);

private:
    alignas(8) unsigned char m_storage[256];
};

}  // namespace utkernel

#if defined(UTKERNEL_ARCH_linux)
#include "arch/linux/msgbuf_impl.hpp"
#elif defined(UTKERNEL_ARCH_microbit)
#include "arch/microbit/msgbuf_impl.hpp"
#else
#error "UTKERNEL_ARCH not defined"
#endif
