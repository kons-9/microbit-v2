#!/bin/bash
# pre-push hook: verify firmware build before push

echo "Running pre-push build check..."

cd "$(git rev-parse --show-toplevel)/firmware" || exit 1

# Clean build
rm -rf build
cmake -B build -DAPP_TARGET=main 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: CMake configure failed."
    exit 1
fi

cmake --build build 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: Build failed. Push aborted."
    exit 1
fi

echo "Build succeeded."
exit 0
